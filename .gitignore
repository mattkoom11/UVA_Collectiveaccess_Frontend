# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# CA disk cache (generated by admin sync, machine-local)
/data/ca-garments-cache.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only demo/placeholder 3D model — a compressed test scan wired to a
# placeholder garments.json entry, not real archive content. Remove this
# line if you want to commit it as a permanent demo asset (it's ~9.5MB,
# under the 10MB guidance) — left ignored by default since it's test data.
/public/models/testdress0-lowpoly.glb
